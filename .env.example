# Copier ce fichier en .env puis renseigner vos propres valeurs :
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env

# --- Obligatoires ---
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAGENDA_API_KEY=your_openagenda_api_key_here

# --- Optionnels (valeurs par défaut si non définies) ---
INDEX_DIR=C:/rag_index
GEO_REGION=Île-de-France
MAX_EVENTS=500
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
