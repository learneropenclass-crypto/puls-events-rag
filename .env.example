# Clé API Mistral (obligatoire) — https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Région géographique cible pour le filtrage des événements
GEO_REGION=Île-de-France

# Nombre maximum d'événements à récupérer via l'API Open Agenda
MAX_EVENTS=500

# Paramètres de chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Nombre de documents retournés par la recherche vectorielle
TOP_K=5

OPENAGENDA_API_KEY=6a4049ca7e5047afb348db0bb3a5e58c
